# .gitignore -- a list of things Git must NEVER upload to GitHub.
# Each non-comment line is a file or folder name.
# A line that starts with "#" is a comment (comments must be on their own line).
# A trailing "/" means "this whole folder". A "*" means "anything".

# ---- R and RStudio housekeeping (temporary files, not part of the project) ----

# the list of commands you typed
.Rhistory
# a saved snapshot of your R session
.RData
# RStudio's private settings for this project
.Rproj.user/

# ---- Secrets: NEVER upload these ----

# where passwords and tokens (for example a Global Fishing Watch API token) go
.Renviron

# ---- Big raw data (stays on your own computer) ----

# raw AIS and SAR downloads, the cache and vessel-level files
data_raw/
# map images (large)
*.tif
# downloaded archives
*.zip
